{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "**/vendor/**",
    "node_modules"
  ]
}
